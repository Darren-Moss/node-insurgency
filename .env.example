# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# --- RCON ---
RCON_HOST=127.0.0.1
RCON_PASS=changeme

# Which server this process attaches to: easy | medium | hard | dev
SERVER=hard

# --- Query ports (defaults shown) ---
PORT_EASY=27011
PORT_MEDIUM=27013
PORT_HARD=27015
PORT_DEV=27015

# --- Insurgency log files to tail ---
# Windows UNC paths work; escape backslashes if your shell requires it.
LOG_EASY=\\YOUR_SERVER\steam\Insurgency_Sandstorm_Easy\Insurgency\Saved\Logs\Insurgency.log
LOG_MEDIUM=\\YOUR_SERVER\steam\Insurgency_Sandstorm_Medium\Insurgency\Saved\Logs\Insurgency.log
LOG_HARD=\\YOUR_SERVER\steam\Insurgency_Sandstorm_Hard\Insurgency\Saved\Logs\Insurgency.log
LOG_DEV=C:\SteamCmd\Servers\insurgency_sandstorm\Insurgency\Saved\Logs\Insurgency.log
